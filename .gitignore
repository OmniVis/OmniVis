# Root-level gitignore for OmniVis monorepo
node_modules/
.DS_Store

# Exclude git backup folders used during monorepo setup
.git_bak/
apps/**/.git_bak/

# Environment and Secrets (Globally match in any folder)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
certificates/
apps/**/certificates/

# IDE and Editor configs (Globally match)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.claude/
apps/**/.claude/

# Build and runtime outputs (managed per-app)
dist/
build/
.next/
out/
.svelte-kit/
.wrangler/
apps/**/.wrangler/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


