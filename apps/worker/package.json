{
  "name": "omnivis-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute omnivis-db --local --file=./migrations/0001_initial.sql",
    "db:migrate:remote": "wrangler d1 execute omnivis-db --remote --file=./migrations/0001_initial.sql",
    "types": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.80.0"
  }
}
